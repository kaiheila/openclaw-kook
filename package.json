{
  "name": "@kookapp/openclaw-kook",
  "version": "1.1.0-beta.2",
  "description": "Kook channel plugin for OpenClaw",
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": {
      "import": "./index.ts"
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "openclaw-kook",
      "label": "Kook",
      "selectionLabel": "Kook",
      "docsPath": "/channels/kook",
      "docsLabel": "kook",
      "blurb": "Kook chat platform integration.",
      "order": 80
    },
    "install": {
      "npmSpec": "@kookapp/openclaw-kook",
      "localPath": ".",
      "defaultChoice": "npm"
    }
  },
  "files": [
    "index.ts",
    "src",
    "openclaw.plugin.json",
    "clawdbot.plugin.json"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'"
  },
  "keywords": [
    "agent",
    "openclaw",
    "clawdbot",
    "moltbot",
    "kook",
    "chat",
    "bot",
    "plugin"
  ],
  "author": "Xiaolong Dong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaiheila/openclaw-kook.git"
  },
  "bugs": {
    "url": "https://github.com/kaiheila/openclaw-kook/issues"
  },
  "homepage": "https://github.com/kaiheila/openclaw-kook",
  "dependencies": {
    "@kookapp/js-sdk": "^0.1.0",
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.4.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.0"
  }
}
